# ---- Database (Neon or any PostgreSQL) ----
# Neon gives you a URL like:
#   postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whc
# Set to "true" for hosted Postgres like Neon (requires SSL). "false" for local.
DATABASE_SSL=false

# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (your Vercel URL in production).
CLIENT_ORIGIN=http://localhost:5173

# ---- Auth (JWT) ----
# Generate long random strings for production, e.g. `openssl rand -hex 48`.
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
